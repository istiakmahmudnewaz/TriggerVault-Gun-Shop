# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Port the shop runs on
PORT=3000

# Set to "production" when the site is online behind HTTPS
NODE_ENV=development

# Only used the FIRST time, to create the admin account (min 10 characters).
# After the admin exists you can change the password inside the admin panel.
ADMIN_NAME=Shop Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-long-password

# Set to 1 when running behind a reverse proxy / hosting platform (Nginx, Render, Vercel, etc.)
TRUST_PROXY=0
